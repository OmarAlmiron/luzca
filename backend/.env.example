# ===== Servidor =====
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Base de datos =====
DATABASE_URL="file:./dev.db"

# ===== Autenticación =====
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECRET=otro-secreto-aleatorio-distinto

# ===== Mercado Pago (https://www.mercadopago.com.ar/developers/panel) =====
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=

# ===== Email transaccional (SMTP - ej. Gmail App Password, SendGrid, Resend) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
EMAIL_FROM="Luzca <ventas@luzca.com.ar>"
SUPPORT_EMAIL=soporte@luzca.com.ar

# ===== Mapas (Google Maps o alternativa gratuita OpenStreetMap/Leaflet ya incluida) =====
GOOGLE_MAPS_API_KEY=

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
